{
  "elements": [
    {
      "type": "Label",
      "caption": "JAP MaxColor USB Device - sendet oder empfängt USB-Signale"
    },
    {
      "type": "ValidationTextBox",
      "name": "Host",
      "caption": "Host (IP)"
    },
    {
      "type": "NumberSpinner",
      "name": "Port",
      "caption": "Port",
      "minimum": 1,
      "maximum": 65535
    },
    {
      "type": "CheckBox",
      "name": "UseCRLF",
      "caption": "Use CRLF (\\r\\n)"
    },
    {
      "type": "Label",
      "caption": " "
    },
    {
      "type": "Label",
      "caption": "USB Routing"
    },
    {
      "type": "Select",
      "name": "USBMode",
      "caption": "USB Modus",
      "options": [
        { "caption": "USB Host (sendet USB)", "value": "HOST" },
        { "caption": "USB Client (empfängt USB)", "value": "CLIENT" }
      ]
    },
    {
      "type": "Label",
      "caption": " "
    },
    {
      "type": "Label",
      "caption": "USB Host Konfiguration (nur wenn Modus = Host)"
    },
    {
      "type": "SelectInstance",
      "name": "RegistryInstanceID",
      "caption": "Registry Instanz",
      "validModules": ["{2E8D5F6A-3C4B-4D1E-9A2B-1C5F8E7D3A40}"]
    },
    {
      "type": "ValidationTextBox",
      "name": "SourceName",
      "caption": "Quellname (für Registry)"
    },
    {
      "type": "NumberSpinner",
      "name": "USBChannel",
      "caption": "USB Kanal",
      "minimum": 0,
      "maximum": 9999
    },
    {
      "type": "CheckBox",
      "name": "AutoAssignFromSchema",
      "caption": "Automatische Kanal-Zuweisung"
    },
    {
      "type": "Label",
      "caption": " "
    },
    {
      "type": "Label",
      "caption": "USB Client Konfiguration (nur wenn Modus = Client)"
    },
    {
      "type": "SelectInstance",
      "name": "RegistryInstanceIDReceiver",
      "caption": "Registry Instanz",
      "validModules": ["{2E8D5F6A-3C4B-4D1E-9A2B-1C5F8E7D3A40}"]
    },
    {
      "type": "NumberSpinner",
      "name": "CommandDelayMs",
      "caption": "Verzögerung zwischen Befehlen (ms)",
      "minimum": 0,
      "maximum": 5000
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "USB Kanal anwenden (nur Host)",
      "onClick": "JAPMC_ApplyUSBChannel($id);"
    }
  ]
}
